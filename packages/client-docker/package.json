{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/client-docker",
  "version": "1.0.0",
  "description": "Wraps Docker CLI commands as procedures using client-shell",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register.js": {
      "import": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run __tests__/docker.integration.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mark1russell7/client": "workspace:*",
    "@mark1russell7/client-shell": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue#main",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "docker",
    "containers",
    "procedures"
  ],
  "license": "MIT",
  "sideEffects": [
    "./dist/index.js",
    "./dist/register.js"
  ],
  "client": {
    "procedures": "./dist/register.js"
  }
}
