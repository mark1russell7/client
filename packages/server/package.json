{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/server",
  "version": "1.0.0",
  "description": "General procedure server - run any procedure packages via HTTP/WebSocket",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run"
  },
  "sideEffects": false,
  "dependencies": {
    "@mark1russell7/client": "workspace:*",
    "@mark1russell7/client-server": "workspace:*"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue#main",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
