{
  "$schema": "https://json.schemastore.org/package",
  "name": "@procedures/server",
  "version": "0.17.3",
  "description": "A standalone procedure server: load procedure packages and serve them over HTTP and WebSocket with a token and an expose list. Its procedures server.start, server.stop and server.status manage the background server of the mark CLI.",
  "keywords": [
    "server",
    "rpc",
    "http",
    "websocket",
    "procedures"
  ],
  "homepage": "https://mark1russell7.github.io/client/",
  "bugs": {
    "url": "https://github.com/mark1russell7/client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/client.git",
    "directory": "packages/server"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "bin": {
    "procedure-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@mark1russell7/service": "^0.5.2",
    "@procedures/client": "workspace:*",
    "@procedures/peer": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^1.0.0",
    "@procedures/fs": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "client": {
    "procedures": "./dist/register.js"
  }
}
