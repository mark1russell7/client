{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/client-node",
  "version": "0.0.1",
  "description": "Node.js process management procedures",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "sideEffects": [
    "./dist/register.js"
  ],
  "dependencies": {
    "zod": "^3.24.0",
    "@mark1russell7/client": "workspace:*",
    "@mark1russell7/client-shell": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0",
    "@mark1russell7/cue": "github:mark1russell7/cue#main"
  },
  "client": {
    "procedures": "./dist/register.js"
  }
}
