{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/bundle-dev",
  "version": "0.1.0",
  "description": "One import that registers the development procedures of the client ecosystem: shell, file system, git, pnpm, workspace, DAG and procedure scaffolding.",
  "keywords": [
    "bundle",
    "procedures",
    "developer-tools",
    "git",
    "pnpm",
    "shell",
    "workflow"
  ],
  "homepage": "https://mark1russell7.github.io/client/",
  "bugs": {
    "url": "https://github.com/mark1russell7/client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/client.git",
    "directory": "packages/bundle-dev"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./register.js": {
      "import": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/register.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mark1russell7/client": "workspace:*",
    "@mark1russell7/client-cli": "workspace:*",
    "@mark1russell7/client-pnpm": "workspace:*",
    "@mark1russell7/client-lib": "workspace:*",
    "@mark1russell7/client-git": "workspace:*",
    "@mark1russell7/client-dag": "workspace:*",
    "@mark1russell7/client-fs": "workspace:*",
    "@mark1russell7/client-shell": "workspace:*",
    "@mark1russell7/client-procedure": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@mark1russell7/cue": "^1.0.0",
    "vitest": "^5.0.3"
  },
  "client": {
    "procedures": "./dist/register.js"
  }
}
