{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/cli",
  "version": "1.0.0",
  "description": "Mark CLI - Development workflow automation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mark": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "prepare": "npm run build",
    "test:e2e": "vitest run e2e/",
    "test:e2e:watch": "vitest e2e/",
    "postinstall": "client announce"
  },
  "dependencies": {
    "@mark1russell7/client": "workspace:*",
    "@mark1russell7/client-cli": "workspace:*",
    "@mark1russell7/client-lib": "workspace:*",
    "@mark1russell7/client-logger": "workspace:*",
    "@mark1russell7/client-pnpm": "workspace:*",
    "@mark1russell7/client-procedure": "workspace:*",
    "@mark1russell7/client-server": "workspace:*",
    "@mark1russell7/client-shell": "workspace:*",
    "@mark1russell7/client-test": "workspace:*",
    "@mark1russell7/client-vitest": "workspace:*",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "cli-table3": "^0.6.5",
    "@clack/prompts": "^0.7.0",
    "tslib": "^2.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue#main",
    "@mark1russell7/test": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "cli",
    "mark",
    "development",
    "workflow",
    "npm",
    "refresh"
  ],
  "license": "MIT",
  "sideEffects": false
}
