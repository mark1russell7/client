{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/cli",
  "version": "0.1.0",
  "description": "mark: one CLI for every procedure package. It finds the procedures, parses flags by their Zod types, runs local or through a fast warm server, and asks for missing arguments.",
  "keywords": [
    "cli",
    "command-line",
    "procedures",
    "developer-tools",
    "automation",
    "zod"
  ],
  "homepage": "https://mark1russell7.github.io/client/",
  "bugs": {
    "url": "https://github.com/mark1russell7/client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/client.git",
    "directory": "packages/mark"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mark": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b && node dist/manifest-build.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:watch": "vitest --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@mark1russell7/client": "workspace:*",
    "@mark1russell7/client-cli": "workspace:*",
    "@mark1russell7/client-lib": "workspace:*",
    "@mark1russell7/client-pnpm": "workspace:*",
    "@mark1russell7/client-procedure": "workspace:*",
    "@mark1russell7/client-server": "workspace:*",
    "@mark1russell7/client-shell": "workspace:*",
    "@mark1russell7/client-vitest": "workspace:*",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "ora": "^8.0.0",
    "tslib": "^2.8.1",
    "zod": "^4.6.5",
    "@mark1russell7/server": "workspace:*",
    "@mark1russell7/mcp-dev-tools": "workspace:*"
  },
  "devDependencies": {
    "@mark1russell7/bundle-dev": "workspace:*",
    "@mark1russell7/bundle-mcp": "workspace:*",
    "@mark1russell7/client-cue": "workspace:*",
    "@mark1russell7/client-docker": "workspace:*",
    "@mark1russell7/client-fs": "workspace:*",
    "@mark1russell7/client-git": "workspace:*",
    "@mark1russell7/client-mongo": "workspace:*",
    "@mark1russell7/client-node": "workspace:*",
    "@mark1russell7/client-s3": "workspace:*",
    "@mark1russell7/client-snapshot": "workspace:*",
    "@mark1russell7/client-splay": "workspace:*",
    "@mark1russell7/client-sqlite": "workspace:*",
    "@mark1russell7/client-store": "workspace:*",
    "@mark1russell7/client-vite": "workspace:*",
    "@mark1russell7/cue": "^1.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
