{
  "$schema": "https://json.schemastore.org/package",
  "name": "@procedures/mark",
  "version": "0.27.4",
  "description": "mark: one CLI for every procedure package. It finds the procedures, parses flags by their Zod types, runs local or through a fast warm server, and asks for missing arguments.",
  "keywords": [
    "cli",
    "command-line",
    "procedures",
    "developer-tools",
    "automation",
    "zod"
  ],
  "homepage": "https://mark1russell7.github.io/client/",
  "bugs": {
    "url": "https://github.com/mark1russell7/client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/client.git",
    "directory": "packages/mark"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mark": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b && node dist/manifest-build.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:watch": "vitest --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@mark1russell7/service": "^0.5.8",
    "@procedures/cli-run": "workspace:*",
    "@procedures/client": "workspace:*",
    "@procedures/lib": "workspace:*",
    "@procedures/mcp-dev-tools": "workspace:*",
    "@procedures/peer": "workspace:*",
    "@procedures/pnpm": "workspace:*",
    "@procedures/procedure": "workspace:*",
    "@procedures/server": "workspace:*",
    "@procedures/shell": "workspace:*",
    "@procedures/vitest": "workspace:*",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "ora": "^8.0.0",
    "tslib": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^1.0.0",
    "@procedures/archive": "workspace:*",
    "@procedures/bundle-assistant": "workspace:*",
    "@procedures/bundle-dev": "workspace:*",
    "@procedures/bundle-mcp": "workspace:*",
    "@procedures/claude-cli": "workspace:*",
    "@procedures/compiler": "workspace:*",
    "@procedures/cue": "workspace:*",
    "@procedures/dag": "workspace:*",
    "@procedures/docker": "workspace:*",
    "@procedures/env": "workspace:*",
    "@procedures/exif": "workspace:*",
    "@procedures/fs": "workspace:*",
    "@procedures/geo": "workspace:*",
    "@procedures/gh": "workspace:*",
    "@procedures/git": "workspace:*",
    "@procedures/http": "workspace:*",
    "@procedures/ics": "workspace:*",
    "@procedures/ios-backup": "workspace:*",
    "@procedures/json": "workspace:*",
    "@procedures/llm": "workspace:*",
    "@procedures/mail": "workspace:*",
    "@procedures/mongo": "workspace:*",
    "@procedures/node": "workspace:*",
    "@procedures/notify": "workspace:*",
    "@procedures/npm": "workspace:*",
    "@procedures/pdf": "workspace:*",
    "@procedures/privacy-scan": "workspace:*",
    "@procedures/restic": "workspace:*",
    "@procedures/s3": "workspace:*",
    "@procedures/schedule": "workspace:*",
    "@procedures/snapshot": "workspace:*",
    "@procedures/splay": "workspace:*",
    "@procedures/sqlite": "workspace:*",
    "@procedures/store": "workspace:*",
    "@procedures/systems": "workspace:*",
    "@procedures/tailscale": "workspace:*",
    "@procedures/vite": "workspace:*",
    "@procedures/weather": "workspace:*",
    "@types/node": "^22.0.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
