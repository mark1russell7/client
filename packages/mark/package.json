{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/cli",
  "version": "1.0.0",
  "description": "Mark CLI - Development workflow automation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mark": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b && node dist/manifest-build.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:watch": "vitest --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@mark1russell7/client": "workspace:*",
    "@mark1russell7/client-cli": "workspace:*",
    "@mark1russell7/client-lib": "workspace:*",
    "@mark1russell7/client-pnpm": "workspace:*",
    "@mark1russell7/client-procedure": "workspace:*",
    "@mark1russell7/client-server": "workspace:*",
    "@mark1russell7/client-shell": "workspace:*",
    "@mark1russell7/client-vitest": "workspace:*",
    "@mark1russell7/mcp": "workspace:*",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "ora": "^8.0.0",
    "tslib": "^2.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@mark1russell7/bundle-dev": "workspace:*",
    "@mark1russell7/bundle-mcp": "workspace:*",
    "@mark1russell7/client-cue": "workspace:*",
    "@mark1russell7/client-docker": "workspace:*",
    "@mark1russell7/client-fs": "workspace:*",
    "@mark1russell7/client-git": "workspace:*",
    "@mark1russell7/client-mongo": "workspace:*",
    "@mark1russell7/client-node": "workspace:*",
    "@mark1russell7/client-s3": "workspace:*",
    "@mark1russell7/client-snapshot": "workspace:*",
    "@mark1russell7/client-splay": "workspace:*",
    "@mark1russell7/client-sqlite": "workspace:*",
    "@mark1russell7/client-vite": "workspace:*",
    "typescript": "^7.0.2",
    "@mark1russell7/cue": "github:mark1russell7/cue#main",
    "vitest": "^5.0.3",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "cli",
    "mark",
    "development",
    "workflow",
    "npm",
    "refresh"
  ],
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  }
}
