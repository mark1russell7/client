{
  "$schema": "https://json.schemastore.org/package",
  "name": "@procedures/peer",
  "version": "0.3.0",
  "description": "Serve procedures: HTTP and WebSocket peers with token authentication, browser checks, an expose list, server.create, server.call and server.connections, and manifests.",
  "keywords": [
    "server",
    "rpc",
    "http",
    "websocket",
    "peer",
    "authentication",
    "procedures"
  ],
  "homepage": "https://mark1russell7.github.io/client/",
  "bugs": {
    "url": "https://github.com/mark1russell7/client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/client.git",
    "directory": "packages/client-server"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./procedures": {
      "types": "./dist/procedures/index.d.ts",
      "import": "./dist/procedures/index.js"
    },
    "./lockfile": {
      "types": "./dist/lockfile.d.ts",
      "import": "./dist/lockfile.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^22.0.0",
    "@mark1russell7/cue": "^1.0.0",
    "vitest": "^5.0.3",
    "@types/express": "^5.0.6"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "client": {
    "procedures": "./dist/register.js"
  },
  "dependencies": {
    "@procedures/client": "workspace:*",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "express": "^5.0.0"
  }
}
