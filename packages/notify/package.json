{
  "$schema": "https://json.schemastore.org/package",
  "name": "@procedures/notify",
  "version": "0.59.1",
  "description": "Push notifications through ntfy (the public server or your own) and Pushover, with emergency messages that repeat until acknowledged, and Twilio texts and voice calls.",
  "keywords": [
    "notification",
    "push",
    "ntfy",
    "pushover",
    "twilio",
    "sms",
    "procedures"
  ],
  "homepage": "https://mark1russell7.github.io/client/",
  "bugs": {
    "url": "https://github.com/mark1russell7/client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/client.git",
    "directory": "packages/notify"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pushover": {
      "types": "./dist/pushover.d.ts",
      "import": "./dist/pushover.js",
      "default": "./dist/pushover.js"
    },
    "./twilio": {
      "types": "./dist/twilio.d.ts",
      "import": "./dist/twilio.js",
      "default": "./dist/twilio.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js",
      "default": "./dist/module.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js",
      "default": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mark1russell7/text": "^0.0.6",
    "@procedures/client": "workspace:*",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@mark1russell7/rigor-testkit": "^0.1.7"
  },
  "peerDependenciesMeta": {
    "@mark1russell7/rigor-testkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^22.0.0",
    "@mark1russell7/cue": "^2.1.1",
    "vitest": "^5.0.3",
    "@mark1russell7/rigor-testkit": "^0.1.7"
  },
  "client": {
    "browser": [
      "./pushover",
      "./twilio"
    ],
    "procedures": "./dist/register.js"
  }
}
