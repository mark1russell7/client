{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/client-lib",
  "version": "0.1.0",
  "description": "Workspace procedures for pnpm monorepos: scan the packages, scaffold a new package, audit packages against a template, rename across the workspace, and program runners.",
  "keywords": [
    "monorepo",
    "pnpm",
    "workspace",
    "scaffold",
    "audit",
    "procedures"
  ],
  "homepage": "https://mark1russell7.github.io/client/",
  "bugs": {
    "url": "https://github.com/mark1russell7/client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/client.git",
    "directory": "packages/client-lib"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli-flags": {
      "types": "./dist/cli-flags.d.ts",
      "import": "./dist/cli-flags.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/register.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^22.0.0",
    "@mark1russell7/cue": "github:mark1russell7/cue#main",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mark1russell7/client": "workspace:*",
    "@mark1russell7/client-dag": "workspace:*",
    "@mark1russell7/client-fs": "workspace:*",
    "@mark1russell7/client-git": "workspace:*",
    "@mark1russell7/client-pnpm": "workspace:*",
    "@mark1russell7/client-shell": "workspace:*",
    "ts-morph": "^24.0.0",
    "zod": "^3.24.0"
  },
  "client": {
    "procedures": "./dist/register.js"
  }
}
