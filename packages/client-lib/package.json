{
  "$schema": "https://json.schemastore.org/package",
  "name": "@procedures/lib",
  "version": "0.27.0",
  "description": "Workspace procedures for pnpm monorepos: scan the packages, graph their dependencies, scaffold a new package, audit packages against a template, and rename across the workspace.",
  "keywords": [
    "monorepo",
    "pnpm",
    "workspace",
    "scaffold",
    "audit",
    "procedures"
  ],
  "homepage": "https://mark1russell7.github.io/client/",
  "bugs": {
    "url": "https://github.com/mark1russell7/client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/client.git",
    "directory": "packages/client-lib"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./cli-flags": {
      "types": "./dist/cli-flags.d.ts",
      "import": "./dist/cli-flags.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^22.0.0",
    "@mark1russell7/cue": "^1.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@procedures/client": "workspace:*",
    "@procedures/dag": "workspace:*",
    "@procedures/fs": "workspace:*",
    "@procedures/git": "workspace:*",
    "@procedures/pnpm": "workspace:*",
    "@procedures/shell": "workspace:*",
    "ts-morph": "^24.0.0",
    "zod": "^4.6.5"
  },
  "client": {
    "procedures": "./dist/register.js"
  }
}
