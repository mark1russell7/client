{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/mcp",
  "version": "0.0.1",
  "description": "Core MCP types and utilities for procedure-to-tool mapping",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "sideEffects": false,
  "dependencies": {
    "zod-to-json-schema": "^3.24.5"
  },
  "peerDependencies": {
    "@mark1russell7/client": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^22.0.0",
    "@mark1russell7/cue": "github:mark1russell7/cue#main",
    "vitest": "^5.0.3",
    "@mark1russell7/client": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
