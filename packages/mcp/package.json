{
  "$schema": "https://json.schemastore.org/package",
  "name": "@procedures/mcp",
  "version": "0.22.1",
  "description": "Map typed procedures to MCP tools: JSON Schema from Zod, tool names, and input and result conversion for Model Context Protocol servers.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "json-schema",
    "zod",
    "tools"
  ],
  "homepage": "https://mark1russell7.github.io/client/",
  "bugs": {
    "url": "https://github.com/mark1russell7/client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/client.git",
    "directory": "packages/mcp"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@procedures/client": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^22.0.0",
    "@mark1russell7/cue": "^1.0.0",
    "vitest": "^5.0.3",
    "@procedures/client": "workspace:*"
  }
}
