{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/client-vitest",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/register.js"
  ],
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue#main",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@mark1russell7/client": "workspace:*",
    "@mark1russell7/client-shell": "workspace:*",
    "@vitest/coverage-v8": "^3.0.0",
    "vitest": "^3.0.0",
    "zod": "^3.24.0"
  },
  "client": {
    "procedures": "./dist/register.js"
  }
}
