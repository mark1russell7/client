{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/client-mcp",
  "version": "0.0.1",
  "description": "MCP server transport for procedure system",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "sideEffects": [
    "./dist/register.js",
    "./src/register.ts"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@mark1russell7/mcp": "github:mark1russell7/mcp#main"
  },
  "peerDependencies": {
    "@mark1russell7/client": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "@mark1russell7/cue": "github:mark1russell7/cue#main",
    "@mark1russell7/client": "github:mark1russell7/client#main",
    "zod": "^3.24.0"
  }
}
