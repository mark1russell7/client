{
  "$schema": "https://json.schemastore.org/package",
  "name": "@procedures/json",
  "version": "0.31.0",
  "description": "Pure JSON, YAML and CSV procedures: a query with JSON Pointer or a path, JSON Patch, a diff, a merge patch, a JSON Schema check, YAML to JSON and back, and CSV (RFC 4180) to rows and back.",
  "keywords": [
    "procedures",
    "json",
    "yaml",
    "csv",
    "json-pointer",
    "json-patch",
    "merge-patch",
    "json-schema",
    "diff"
  ],
  "homepage": "https://mark1russell7.github.io/client/",
  "bugs": {
    "url": "https://github.com/mark1russell7/client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/client.git",
    "directory": "packages/json"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./csv": {
      "types": "./dist/csv-entry.d.ts",
      "import": "./dist/csv-entry.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "sideEffects": [
    "./dist/register.js"
  ],
  "devDependencies": {
    "@mark1russell7/cue": "^1.0.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "client": {
    "procedures": "./dist/register.js"
  },
  "dependencies": {
    "@procedures/client": "workspace:*",
    "@procedures/compiler": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
