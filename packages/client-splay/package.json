{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/client-splay",
  "version": "1.0.0",
  "description": "Bridge between splay and client - component rendering via procedures",
  "license": "MIT",
  "author": "Mark Russell <marktheprogrammer17@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run"
  },
  "sideEffects": [
    "./dist/register.js"
  ],
  "client": {
    "procedures": "./dist/register.js"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue#main",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@mark1russell7/client": "workspace:*",
    "@mark1russell7/splay": "github:mark1russell7/splay#main"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/mark1russell7/client-splay.git"
  },
  "bugs": {
    "url": "https://github.com/mark1russell7/client-splay/issues"
  },
  "homepage": "https://github.com/mark1russell7/client-splay#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=25.0.0",
    "npm": ">=11.0.0"
  }
}
