{
  "$schema": "https://json.schemastore.org/package",
  "name": "@procedures/pdf",
  "version": "0.54.0",
  "description": "HTML to PDF with a headless Chromium browser that is already installed (Edge, Chrome or Chromium), as the procedure pdf.render. The render is in @procedures/browser.",
  "keywords": [
    "pdf",
    "html",
    "headless",
    "chrome",
    "edge",
    "procedures"
  ],
  "homepage": "https://mark1russell7.github.io/client/",
  "bugs": {
    "url": "https://github.com/mark1russell7/client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/client.git",
    "directory": "packages/pdf"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@procedures/browser": "workspace:*",
    "@procedures/client": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^22.0.0",
    "@mark1russell7/cue": "^2.1.1",
    "vitest": "^5.0.3",
    "@procedures/shell": "workspace:*"
  },
  "client": {
    "procedures": "./dist/register.js"
  }
}
