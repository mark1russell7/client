{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/bundle-mcp",
  "version": "1.0.0",
  "description": "Curated MCP bundle - high-level orchestration tools for Claude",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register.js": {
      "import": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "sideEffects": [
    "./dist/register.js"
  ],
  "dependencies": {
    "@mark1russell7/client": "workspace:*",
    "@mark1russell7/client-lib": "workspace:*",
    "@mark1russell7/client-procedure": "workspace:*",
    "@mark1russell7/client-cue": "workspace:*",
    "@mark1russell7/client-docker": "workspace:*",
    "@mark1russell7/client-mongo": "workspace:*",
    "@mark1russell7/client-sqlite": "workspace:*",
    "@mark1russell7/client-vitest": "workspace:*"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue#main",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "bundle",
    "mcp",
    "procedures",
    "claude"
  ],
  "license": "MIT",
  "client": {
    "procedures": "./dist/register.js"
  }
}
