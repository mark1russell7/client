{
  "$schema": "https://json.schemastore.org/package",
  "name": "@procedures/bundle-mcp",
  "version": "0.17.4",
  "description": "The curated tool surface for Claude: registers the docker, mongo, sqlite, cue, vitest and workspace procedures and selects which ones an MCP server exposes.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai-tools",
    "tools",
    "bundle",
    "procedures"
  ],
  "homepage": "https://mark1russell7.github.io/client/",
  "bugs": {
    "url": "https://github.com/mark1russell7/client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/client.git",
    "directory": "packages/bundle-mcp"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./register.js": {
      "import": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@procedures/client": "workspace:*",
    "@procedures/compiler": "workspace:*",
    "@procedures/cue": "workspace:*",
    "@procedures/dag": "workspace:*",
    "@procedures/docker": "workspace:*",
    "@procedures/json": "workspace:*",
    "@procedures/lib": "workspace:*",
    "@procedures/mongo": "workspace:*",
    "@procedures/procedure": "workspace:*",
    "@procedures/sqlite": "workspace:*",
    "@procedures/vitest": "workspace:*"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^1.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "client": {
    "procedures": "./dist/register.js"
  }
}
