{
  "$schema": "https://json.schemastore.org/package",
  "name": "@procedures/client",
  "version": "0.24.1",
  "description": "Procedures as data for TypeScript: define typed procedures once and call them in process, over HTTP, WebSocket, the CLI or MCP. Streaming, middleware, retries, caching and a JSON program format.",
  "keywords": [
    "rpc",
    "procedures",
    "typescript",
    "type-safe",
    "http",
    "websocket",
    "streaming",
    "middleware",
    "mcp",
    "json-rpc",
    "workflow",
    "dsl",
    "zod",
    "client",
    "server"
  ],
  "homepage": "https://mark1russell7.github.io/client/",
  "bugs": {
    "url": "https://github.com/mark1russell7/client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/client.git",
    "directory": "packages/client"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js"
    },
    "./procedures": {
      "types": "./dist/procedures/index.d.ts",
      "import": "./dist/procedures/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./query": {
      "types": "./dist/procedures/collection/query.d.ts",
      "import": "./dist/procedures/collection/query.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "client": {
    "browser": [
      ".",
      "./browser",
      "./client",
      "./events",
      "./procedures",
      "./middleware",
      "./query",
      "./register"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "tsc -b --watch"
  },
  "dependencies": {
    "@mark1russell7/algebra": "^0.7.1",
    "@mark1russell7/quantity": "^0.2.0",
    "@mark1russell7/service": "^0.5.8",
    "@types/ws": "^8.18.1",
    "ws": "^8.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^1.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
