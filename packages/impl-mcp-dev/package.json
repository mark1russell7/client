{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/impl-mcp-dev",
  "version": "0.0.1",
  "description": "Ready-to-use MCP server exposing the procedure ecosystem to Claude",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-server": "./bin/mcp-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "sideEffects": false,
  "dependencies": {
    "@mark1russell7/bundle-mcp": "workspace:*",
    "@mark1russell7/client": "workspace:*",
    "@mark1russell7/client-mcp": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^22.0.0",
    "@mark1russell7/cue": "github:mark1russell7/cue#main",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
