  "logs.query": {
    "type": "object",
    "properties": {
      "sessionId": {
        "description": "Only the entries of this session",
        "type": "string"
      },
      "command": {
        "description": "Only the entries of this command",
        "type": "string"
      },
      "level": {
        "description": "Only the entries of this level, or of these levels",
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "trace",
              "debug",
              "info",
              "warn",
              "error"
            ]
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "trace",
                "debug",
                "info",
                "warn",
                "error"
              ]
            }
          }
        ]
      },
      "limit": {
        "description": "The most entries to give",
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "offset": {
        "description": "The number of entries to skip (for pages)",
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "orderBy": {
        "description": "The order by time: desc (the default, newest first) or asc",
        "type": "string",
        "enum": [
          "asc",
          "desc"
        ]
      },
      "dbPath": {
        "description": "The SQLite database file (default: <home>/logs/cli/cli.db). A query does not make a missing file.",
        "type": "string"
      }
    }
  },
  "logs.store": {
    "type": "object",
