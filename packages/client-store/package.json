{
  "$schema": "https://json.schemastore.org/package",
  "name": "@procedures/store",
  "version": "0.24.1",
  "description": "A program store for procedure-as-data: save the programs that procedure.define makes, load them back after a restart, in memory, a JSON file, IndexedDB or a remote collection storage.",
  "keywords": [
    "program-store",
    "procedures",
    "json-programs",
    "persistence",
    "registry",
    "rpc"
  ],
  "homepage": "https://mark1russell7.github.io/client/",
  "bugs": {
    "url": "https://github.com/mark1russell7/client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/client.git",
    "directory": "packages/client-store"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./file-queue": {
      "types": "./dist/storage/file-queue.d.ts",
      "import": "./dist/storage/file-queue.js"
    },
    "./indexeddb": {
      "types": "./dist/indexeddb.d.ts",
      "import": "./dist/indexeddb.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "client": {
    "procedures": "./dist/register.js",
    "browser": [
      "./indexeddb",
      "./browser"
    ]
  },
  "dependencies": {
    "@mark1russell7/service": "^0.5.8",
    "@procedures/client": "workspace:*",
    "@procedures/collections": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@procedures/fs": "workspace:*",
    "@mark1russell7/cue": "^1.0.0",
    "@types/node": "^22.0.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
