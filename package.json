{
  "$schema": "https://json.schemastore.org/package",
  "name": "mark1russell7-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "tsc -p tsconfig.scripts.json && pnpm -r run typecheck",
    "lint:ste": "ste-lint",
    "changeset": "changeset",
    "check:api": "api-report check",
    "check:packages": "node scripts/check-packages.ts",
    "check:boundaries": "depcruise --config .dependency-cruiser.ts \"packages/*/src\"",
    "check:paths-and-writes": "node scripts/check-paths-and-writes.ts",
    "check:conventions": "conventions check",
    "release-train:update": "node scripts/release-train-update.ts",
    "release:bootstrap": "node scripts/npm-bootstrap.ts"
  },
  "sitePages": {
    "bareErrors": "fail"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/parser": "^8.0.7",
    "@changesets/cli": "^3.0.3",
    "@mark1russell7/api-report": "^0.5.0",
    "@mark1russell7/boundaries": "^0.3.0",
    "@mark1russell7/conventions": "^0.52.0",
    "@mark1russell7/cue": "^2.1.1",
    "@mark1russell7/rigor-bench": "^0.2.60",
    "@mark1russell7/rigor-generators": "^0.2.0",
    "@mark1russell7/rigor-statistics": "^0.1.22",
    "@mark1russell7/service": "^0.11.0",
    "@mark1russell7/ste-lint": "^0.6.0",
    "@swc/core": "^1.16.20",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.7.0",
    "esbuild": "^0.28.2",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "conventions": {
    "rules": {
      "no-local-paths": {
        "allow": [
          "newdev",
          "someone",
          "test",
          "your_username"
        ],
        "reason": "these names are placeholders of examples and tests (client-snapshot README, ONBOARDING-2026-07, the tests of ios-backup and restic), not people"
      },
      "roadmap-parses": {
        "roadmaps": [
          "packages/documentation/ROADMAP-2026-10.md"
        ],
        "reason": "packages/site/scripts/gen-data.ts gives it to readStatusBoard of site-pages"
      },
      "source-main": {
        "main": "./dist/index.js",
        "reason": "the packages of client are built by design (D:/git/CLAUDE.md), so main is the build. The move to source packages is its own roadmap item"
      }
    }
  }
}
