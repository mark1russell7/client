{
  "$schema": "https://json.schemastore.org/package",
  "name": "mark1russell7-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "package": "tsx packages/cli/src/index.ts package",
    "template": "tsx packages/cli/src/index.ts repo",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint:ste": "ste-lint",
    "changeset": "changeset",
    "check:packages": "node scripts/check-packages.mjs",
    "release:bootstrap": "node scripts/npm-bootstrap.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@mark1russell7/cue": "^1.0.0",
    "@mark1russell7/ste-lint": "github:mark1russell7/ste-lint",
    "@vitest/coverage-v8": "5.0.3",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
