{
  "$schema": "https://json.schemastore.org/package",
  "name": "mark1russell7-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint:ste": "ste-lint",
    "changeset": "changeset",
    "check:packages": "node scripts/check-packages.mjs",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs \"packages/*/src\"",
    "check:paths-and-writes": "node scripts/check-paths-and-writes.mjs",
    "check:conventions": "conventions check",
    "release:bootstrap": "node scripts/npm-bootstrap.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/parser": "^8.0.7",
    "@changesets/cli": "^3.0.3",
    "@mark1russell7/boundaries": "^0.2.0",
    "@mark1russell7/conventions": "^0.7.0",
    "@mark1russell7/cue": "^1.0.0",
    "@mark1russell7/ste-lint": "^0.1.1",
    "@swc/core": "^1.16.20",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "^18.7.0",
    "esbuild": "^0.28.2",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "conventions": {
    "rules": {
      "no-local-paths": {
        "allow": ["newdev", "someone", "test", "your_username"],
        "reason": "these names are placeholders of examples and tests (client-snapshot README, ONBOARDING-2026-07, the tests of ios-backup and restic), not people"
      },
      "roadmap-parses": {
        "roadmaps": ["packages/documentation/ROADMAP-2026-10.md"],
        "reason": "packages/site/scripts/gen-data.mjs gives it to readStatusBoard of site-pages"
      }
    }
  }
}
