# Claude Code
.claude/
.mcp.json

# Local data
_db/

# Project-root MD files. Only intentional ones are allowlisted below; everything else
# (e.g. scratch dumps from Explore agents during research) is ignored so they don't
# accidentally get committed via `git add .`. If a future doc legitimately belongs at
# repo root, add an explicit allowlist line here.
/*.md
!/CLAUDE.md
!/README.md

# Local ste-lint dictionaries. The ASD-STE100 dictionary is copyrighted: do not commit it.
.ste/
*.ste-dictionary.json

# Tokens / API keys
*.token
*sensitive*

# OS
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-workspace
*.sublime-project

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
credentials.*

# Logs. Do not ignore a "logs/" folder: client-sqlite has logs.* procedures.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output. Each package builds dist/ with `tsc -b`, so dist/ is never committed.
# Do not add Python-style "lib/", "build/" or "env/" rules: they match procedure source folders.
dist/
*.tsbuildinfo
.coverage
coverage/

# The registry file that `client announce` writes at the workspace root
.client-registry.json

# Node / JS
node_modules/
.npm
.yarn/
.pnp.*
.next/
.nuxt/
.parcel-cache/
.turbo/
.svelte-kit/
.cache/

# DuckDB / data
*.duckdb
*.duckdb.wal
*.duckdb.tmp/
*.db
*.sqlite
*.sqlite3

# Build / temp
tmp/
temp/
*.tmp
*.bak
*.orig
